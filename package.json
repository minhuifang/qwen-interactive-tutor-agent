{
  "name": "qwen-interactive-tutor-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "typecheck": "pnpm --dir apps/web exec tsc --noEmit",
    "test": "node --test tests/*.test.ts packages/agent/loop.test.mjs packages/agent/teaching.test.mjs packages/runner/agent-http.test.mjs packages/runner/teaching-http.test.mjs",
    "test:agent": "node --test packages/agent/loop.test.mjs packages/runner/agent-http.test.mjs",
    "test:teaching": "node --test packages/agent/teaching.test.mjs packages/runner/teaching-http.test.mjs",
    "eval:check": "node eval/self-check.mjs",
    "eval:run": "node eval/run.mjs",
    "demo:record": "node packages/agent/record-demo.mjs"
  },
  "engines": { "node": ">=22.18.0" }
}
