# Reference only. The web service reads apps/web/.env.local, not this root file.
# Use apps/web/.env.example as the local configuration template.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Only speech synthesis continues to use DashScope.
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_VOICE=Cherry
